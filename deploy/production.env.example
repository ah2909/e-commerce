APP_ENV=production
HTTP_ADDRESS=:8080
METRICS_ADDRESS=:9090
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318
LOG_LEVEL=info
REDIS_TLS_ENABLED=true
TENANT_ROUTING_MODE=multi_store
TENANT_BASE_DOMAIN=commerce.example.com
PLATFORM_HOST=commerce.example.com
AUTH_HOST=auth.commerce.example.com
DATABASE_MAX_OPEN=20
DATABASE_MAX_IDLE=10
DATABASE_CONNECTION_LIFETIME=30m
DATABASE_CONNECTION_IDLE_TIME=5m
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_LOCK_TIMEOUT=3s
DATABASE_IDLE_TRANSACTION_TIMEOUT=15s
SLOW_QUERY_THRESHOLD=500ms
SHUTDOWN_TIMEOUT=30s
DEPENDENCY_TIMEOUT=3s
TENANT_RESOLUTION_TIMEOUT=750ms
TRUSTED_PROXY_CIDRS=10.0.0.0/8
CORS_ALLOWED_ORIGINS=https://shop.commerce.example.com
EVENT_BATCH=50
EVENT_POLL=1s
EVENT_CLAIM_LEASE=30s
EVENT_MAX_ATTEMPTS=12
EVENT_RETRY_BASE=1s
EVENT_RETRY_MAX=5m
EVENT_RETENTION_HOLD=true
KAFKA_TLS_ENABLED=true
MOMO_API_BASE_URL=https://payment.momo.vn
MOMO_REDIRECT_URL=https://shop.commerce.example.com/payments/momo/return
MOMO_PUBLIC_URL=https://commerce.example.com
MOMO_REQUEST_TIMEOUT=35s
