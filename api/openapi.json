{
  "openapi": "3.1.0",
  "info": {"title": "E-commerce API", "version": "1.0.0"},
  "servers": [{"url": "https://{store}.{baseDomain}", "variables": {"store": {"default": "shop"}, "baseDomain": {"default": "example.test"}}}],
  "paths": {
    "/health/live": {"get": {"operationId": "liveness", "responses": {"200": {"description": "Process is live"}}}},
    "/health/ready": {"get": {"operationId": "readiness", "responses": {"200": {"description": "Dependencies are ready"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/registrations": {"post": {"operationId": "register", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordLogin"}}}}, "responses": {"201": {"$ref": "#/components/responses/UserSession"}, "400": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/sessions": {"post": {"operationId": "login", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordLogin"}}}}, "responses": {"200": {"$ref": "#/components/responses/UserSession"}, "401": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/sessions/refresh": {"post": {"operationId": "refreshUserSession", "requestBody": {"$ref": "#/components/requestBodies/Refresh"}, "responses": {"200": {"$ref": "#/components/responses/TokenPair"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/sessions/current": {"delete": {"operationId": "logoutUserSession", "security": [{"bearerAuth": []}], "responses": {"204": {"description": "Session revoked"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/me": {"get": {"operationId": "currentUser", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Current user", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/social/{provider}/sessions": {"post": {"operationId": "startSocialLogin", "parameters": [{"$ref": "#/components/parameters/Provider"}], "requestBody": {"$ref": "#/components/requestBodies/SocialStart"}, "responses": {"200": {"$ref": "#/components/responses/SocialAuthorization"}, "400": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/social/{provider}/links": {"post": {"operationId": "startSocialLink", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Provider"}], "requestBody": {"$ref": "#/components/requestBodies/SocialStart"}, "responses": {"200": {"$ref": "#/components/responses/SocialAuthorization"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/social/continue": {"get": {"operationId": "continueSocialLogin", "servers": [{"url": "https://auth.{baseDomain}", "variables": {"baseDomain": {"default": "example.test"}}}], "parameters": [{"name": "code", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"303": {"description": "Redirect to the configured provider"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/social/{provider}/callback": {"get": {"operationId": "socialCallback", "servers": [{"url": "https://auth.{baseDomain}", "variables": {"baseDomain": {"default": "example.test"}}}], "parameters": [{"$ref": "#/components/parameters/Provider"}, {"name": "state", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "code", "in": "query", "schema": {"type": "string"}}, {"name": "error", "in": "query", "schema": {"type": "string"}}], "responses": {"303": {"description": "Redirect with one-time exchange code"}, "401": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/auth/social/exchanges": {"post": {"operationId": "exchangeSocialCode", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["exchange_code"], "additionalProperties": false, "properties": {"exchange_code": {"type": "string"}}}}}}, "responses": {"200": {"$ref": "#/components/responses/UserSession"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/onboarding/stores": {"post": {"operationId": "onboardStore", "servers": [{"url": "https://{baseDomain}", "variables": {"baseDomain": {"default": "example.test"}}}], "security": [{"platformAdminBearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OnboardStore"}}}}, "responses": {"201": {"$ref": "#/components/responses/OnboardingResult"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/store": {"get": {"operationId": "getStore", "security": [{"bearerAuth": []}], "responses": {"200": {"$ref": "#/components/responses/StoreContext"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/guest-sessions": {"post": {"operationId": "createGuestSession", "responses": {"201": {"$ref": "#/components/responses/GuestSession"}, "404": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}}}},
    "/api/v1/guest-sessions/refresh": {"post": {"operationId": "refreshGuestSession", "requestBody": {"$ref": "#/components/requestBodies/Refresh"}, "responses": {"200": {"$ref": "#/components/responses/TokenPair"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/guest-sessions/current": {"get": {"operationId": "currentGuestSession", "security": [{"bearerAuth": []}], "responses": {"200": {"$ref": "#/components/responses/CurrentGuestSession"}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}, "delete": {"operationId": "logoutGuestSession", "security": [{"bearerAuth": []}], "responses": {"204": {"description": "Guest session revoked"}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/memberships": {"get": {"operationId": "listMemberships", "security": [{"bearerAuth": []}], "responses": {"200": {"$ref": "#/components/responses/MembershipList"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}, "post": {"operationId": "addMembership", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddMembership"}}}}, "responses": {"201": {"$ref": "#/components/responses/Membership"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/memberships/{user_id}": {"patch": {"operationId": "updateMembership", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/UserID"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateMembership"}}}}, "responses": {"200": {"$ref": "#/components/responses/Membership"}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}, "platformAdminBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "deployment-admin-token"}},
    "parameters": {
      "StoreID": {"name": "store_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "UserID": {"name": "user_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "Provider": {"name": "provider", "in": "path", "required": true, "schema": {"type": "string", "enum": ["google", "facebook"]}}
    },
    "requestBodies": {
      "Refresh": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["refresh_token"], "additionalProperties": false, "properties": {"refresh_token": {"type": "string"}}}}}},
      "SocialStart": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["return_path"], "additionalProperties": false, "properties": {"return_path": {"type": "string"}}}}}}
    },
    "responses": {
      "Problem": {"description": "Problem response", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "RateLimited": {"description": "Rate limited", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "TokenPair": {"description": "Opaque token pair", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPair"}}}},
      "UserSession": {"description": "Store-bound user and opaque token pair", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/TokenPair"}, {"type": "object", "required": ["store_id", "user_id"], "properties": {"store_id": {"type": "string", "format": "uuid"}, "user_id": {"type": "string", "format": "uuid"}}}]}}}},
      "OnboardingResult": {"description": "New store and owner identifiers; the owner signs in on the store host", "content": {"application/json": {"schema": {"type": "object", "required": ["store_id", "subdomain", "owner_user_id"], "additionalProperties": false, "properties": {"store_id": {"type": "string", "format": "uuid"}, "subdomain": {"$ref": "#/components/schemas/Subdomain"}, "owner_user_id": {"type": "string", "format": "uuid"}}}}}},
      "GuestSession": {"description": "Guest and opaque token pair", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/TokenPair"}, {"type": "object", "required": ["guest_id", "store_id"], "properties": {"guest_id": {"type": "string", "format": "uuid"}, "store_id": {"type": "string", "format": "uuid"}}}]}}}},
      "CurrentGuestSession": {"description": "Current guest session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrentGuestSession"}}}},
      "SocialAuthorization": {"description": "Provider authorization URL", "content": {"application/json": {"schema": {"type": "object", "required": ["authorization_url"], "additionalProperties": false, "properties": {"authorization_url": {"type": "string", "format": "uri"}}}}}},
      "Store": {"description": "Store", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Store"}}}},
      "StoreContext": {"description": "Authorized store context", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StoreContext"}}}},
      "Membership": {"description": "Store membership", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Membership"}}}},
      "MembershipList": {"description": "Store memberships", "content": {"application/json": {"schema": {"type": "object", "required": ["memberships"], "additionalProperties": false, "properties": {"memberships": {"type": "array", "items": {"$ref": "#/components/schemas/Membership"}}}}}}}
    },
    "schemas": {
      "PasswordLogin": {"type": "object", "required": ["email", "password"], "additionalProperties": false, "properties": {"email": {"type": "string", "format": "email", "maxLength": 254}, "password": {"type": "string", "minLength": 12, "maxLength": 128, "writeOnly": true}}},
      "OnboardStore": {"type": "object", "required": ["subdomain", "store_name", "email", "password"], "additionalProperties": false, "properties": {"subdomain": {"$ref": "#/components/schemas/Subdomain"}, "store_name": {"type": "string", "maxLength": 120}, "default_currency": {"type": "string", "default": "VND"}, "locale": {"type": "string", "default": "vi-VN"}, "timezone": {"type": "string", "default": "Asia/Ho_Chi_Minh"}, "email": {"type": "string", "format": "email", "maxLength": 254}, "password": {"type": "string", "minLength": 12, "maxLength": 128, "writeOnly": true}}},
      "AddMembership": {"type": "object", "required": ["user_id", "role"], "additionalProperties": false, "properties": {"user_id": {"type": "string", "format": "uuid"}, "role": {"$ref": "#/components/schemas/Role"}}},
      "UpdateMembership": {"type": "object", "required": ["role", "status"], "additionalProperties": false, "properties": {"role": {"$ref": "#/components/schemas/Role"}, "status": {"$ref": "#/components/schemas/MembershipStatus"}}},
      "TokenPair": {"type": "object", "required": ["access_token", "refresh_token", "token_type", "access_expires_at", "session_expires_at", "session_id"], "properties": {"access_token": {"type": "string", "writeOnly": true}, "refresh_token": {"type": "string", "writeOnly": true}, "token_type": {"const": "Bearer"}, "access_expires_at": {"type": "string", "format": "date-time"}, "session_expires_at": {"type": "string", "format": "date-time"}, "session_id": {"type": "string", "format": "uuid"}}},
      "CurrentGuestSession": {"type": "object", "required": ["guest_id", "store_id", "session_id", "access_expires_at", "session_expires_at"], "additionalProperties": false, "properties": {"guest_id": {"type": "string", "format": "uuid"}, "store_id": {"type": "string", "format": "uuid"}, "session_id": {"type": "string", "format": "uuid"}, "access_expires_at": {"type": "string", "format": "date-time"}, "session_expires_at": {"type": "string", "format": "date-time"}}},
      "User": {"type": "object", "required": ["store_id", "user_id", "email", "status", "created_at", "updated_at"], "properties": {"store_id": {"type": "string", "format": "uuid"}, "user_id": {"type": "string", "format": "uuid"}, "email": {"type": ["string", "null"], "format": "email"}, "status": {"type": "string", "enum": ["active", "disabled"]}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "Store": {"type": "object", "required": ["store_id", "subdomain", "name", "status", "default_currency", "locale", "timezone", "settings_version", "created_at", "updated_at"], "additionalProperties": false, "properties": {"store_id": {"type": "string", "format": "uuid"}, "subdomain": {"$ref": "#/components/schemas/Subdomain"}, "name": {"type": "string"}, "status": {"type": "string", "enum": ["active", "suspended"]}, "default_currency": {"type": "string"}, "locale": {"type": "string"}, "timezone": {"type": "string"}, "settings_version": {"type": "integer", "minimum": 1}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "StoreContext": {"type": "object", "required": ["store_id", "subdomain", "name", "status", "default_currency", "locale", "timezone", "settings_version", "role"], "additionalProperties": false, "properties": {"store_id": {"type": "string", "format": "uuid"}, "subdomain": {"$ref": "#/components/schemas/Subdomain"}, "name": {"type": "string"}, "status": {"type": "string", "enum": ["active", "suspended"]}, "default_currency": {"type": "string"}, "locale": {"type": "string"}, "timezone": {"type": "string"}, "settings_version": {"type": "integer", "minimum": 1}, "role": {"$ref": "#/components/schemas/Role"}}},
      "Membership": {"type": "object", "required": ["store_id", "user_id", "status", "role", "created_at", "updated_at"], "additionalProperties": false, "properties": {"store_id": {"type": "string", "format": "uuid"}, "user_id": {"type": "string", "format": "uuid"}, "status": {"$ref": "#/components/schemas/MembershipStatus"}, "role": {"$ref": "#/components/schemas/Role"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "Role": {"type": "string", "enum": ["owner", "admin", "staff"]},
      "MembershipStatus": {"type": "string", "enum": ["active", "inactive"]},
      "Subdomain": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"},
      "Problem": {"type": "object", "required": ["code", "message", "details", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}, "request_id": {"type": "string"}}}
    }
  }
}
